=== source spans | duration > 250ms and duration <= 2s | stats p95(duration), avg(duration) by service span 5m
kind: timeseries  source: spans  limit: 10000  span: 5m0s
canonical: source spans | duration > 250ms and duration <= 2s | stats p95(duration), avg(duration) by service span 5m
sql: SELECT toStartOfInterval(start_time, toIntervalSecond(?)) AS bucket, service AS g0, quantileTDigest(0.95)(duration_ns / 1e6) AS a0, avg(duration_ns / 1e6) AS a1 FROM tidemark.spans WHERE start_time >= ? AND start_time < ? AND (duration_ns > ? AND duration_ns <= ?) GROUP BY bucket, g0 ORDER BY bucket ASC, g0 ASC LIMIT ?
args:
  0: int64 300
  1: time 2026-10-13T11:00:00Z
  2: time 2026-10-13T12:00:00Z
  3: float64 2.5e+08
  4: float64 2e+09
  5: int 10000
columns: @bucket:time, service:string, p95_duration:number, avg_duration:number

