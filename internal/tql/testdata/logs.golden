=== * | stats count() by level | where level in [error, fatal] and not has(level) or contains(level, 'err')
kind: table  source: logs  limit: 10000
canonical: * | stats count() by level | where level in ["error", "fatal"] and not has(level) or contains(level, "err")
sql: SELECT level AS g0, count() AS a0 FROM tidemark.events WHERE timestamp >= ? AND timestamp < ? GROUP BY g0 HAVING ((g0 IN (?, ?) AND NOT (g0 != '')) OR positionCaseInsensitiveUTF8(g0, ?) > 0) ORDER BY a0 DESC, g0 ASC LIMIT ?
args:
  0: time 2026-10-13T11:00:00Z
  1: time 2026-10-13T12:00:00Z
  2: string "Error"
  3: string "Fatal"
  4: string "err"
  5: int 10000
columns: level:string, count:number

=== * | stats count() by level | where level:err* and level != error and count in [1, 2]
kind: table  source: logs  limit: 10000
canonical: * | stats count() by level | where level:err* and level != "error" and count in [1, 2]
sql: SELECT level AS g0, count() AS a0 FROM tidemark.events WHERE timestamp >= ? AND timestamp < ? GROUP BY g0 HAVING ((g0 ILIKE ? AND NOT (g0 IN (?))) AND a0 IN (?, ?)) ORDER BY a0 DESC, g0 ASC LIMIT ?
args:
