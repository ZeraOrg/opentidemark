sql: SELECT bucket, g0, if(h_n = 0, NULL, h_s / h_n) AS a0 FROM (SELECT bucket, g0, sum(h_ds) AS h_s, sum(h_dn) AS h_n FROM (SELECT toStartOfInterval(timestamp, toIntervalSecond(?)) AS bucket, service AS g0, timestamp, row_number() OVER w = 1 AS h_first, toUnixTimestamp64Nano(start_time) AS h_st, lagInFrame(toUnixTimestamp64Nano(start_time)) OVER w AS h_pst, lagInFrame(`count`) OVER w AS h_pn, lagInFrame(bucket_counts) OVER w AS h_pc, bucket_bounds = lagInFrame(bucket_bounds) OVER w AS h_same, temporality = 'delta' OR (NOT h_first AND ((h_st != 0 AND h_pst != 0 AND h_st != h_pst) OR `count` < h_pn OR (h_same AND arrayExists((x, y) -> x < y, bucket_counts, arrayResize(h_pc, length(bucket_counts)))))) OR (h_first AND h_st != 0 AND start_time >= ?) AS h_whole, multiIf(h_whole, toInt64(`count`), h_first, 0, toInt64(`count`) - toInt64(h_pn)) AS h_dn, multiIf(h_whole, `sum`, h_first, 0, `sum` - lagInFrame(`sum`) OVER w) AS h_ds FROM tidemark.metric_points WHERE timestamp >= ? AND timestamp < ? AND (lower(name) = lower(?)) AND (kind IN ('histogram', 'exp_histogram') OR (kind = 'summary' AND temporality != '')) WINDOW w AS (PARTITION BY stream, series_id ORDER BY timestamp ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)) WHERE timestamp >= ? GROUP BY bucket, g0 HAVING count() > 0) ORDER BY bucket ASC, g0 ASC LIMIT ?
