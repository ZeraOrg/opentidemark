columns: route:string, p50:number, histogram_quantile_0_99:number, hist_mean:number

=== source metrics | name:x | stats rate(value) * 60 as per_minute by service span 1m
kind: timeseries  source: metrics  limit: 10000  span: 1m0s
canonical: source metrics | name:"x" | stats rate(value) * 60 as per_minute by service span 1m
sql: SELECT bucket, g0, (sum(r_d) / ? * ?) AS a0 FROM (SELECT toStartOfInterval(timestamp, toIntervalSecond(?)) AS bucket, service AS g0, timestamp, row_number() OVER w = 1 AS r_first, toUnixTimestamp64Nano(start_time) AS r_st, lagInFrame(toUnixTimestamp64Nano(start_time)) OVER w AS r_pst, lagInFrame(value) OVER w AS r_pv, multiIf(temporality = 'delta' OR (NOT r_first AND ((r_st != 0 AND r_pst != 0 AND r_st != r_pst) OR value < r_pv)) OR (r_first AND r_st != 0 AND start_time >= ?), value, r_first, 0, value - r_pv) AS r_d FROM tidemark.metric_points WHERE timestamp >= ? AND timestamp < ? AND (lower(name) = lower(?)) WINDOW w AS (PARTITION BY stream, series_id ORDER BY timestamp ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)) WHERE timestamp >= ? GROUP BY bucket, g0 ORDER BY bucket ASC, g0 ASC LIMIT ?
