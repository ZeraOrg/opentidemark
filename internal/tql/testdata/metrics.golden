canonical: source metrics | name:"x" | stats histogram_quantile(0.5) as p50, histogram_quantile(0.99), hist_mean() by route | where p50 > 10
sql: SELECT g0, multiIf(h_c[-1] <= 0, NULL, isInfinite(h_k[h_i0]), if(h_i0 = 1, NULL, h_k[h_i0 - 1]), h_i0 = 1, if(h_k[1] <= 0, h_k[1], h_k[1] * h_r0 / h_c[1]), h_k[h_i0 - 1] + (h_k[h_i0] - h_k[h_i0 - 1]) * (h_r0 - h_c[h_i0 - 1]) / (h_c[h_i0] - h_c[h_i0 - 1])) AS a0, multiIf(h_c[-1] <= 0, NULL, isInfinite(h_k[h_i1]), if(h_i1 = 1, NULL, h_k[h_i1 - 1]), h_i1 = 1, if(h_k[1] <= 0, h_k[1], h_k[1] * h_r1 / h_c[1]), h_k[h_i1 - 1] + (h_k[h_i1] - h_k[h_i1 - 1]) * (h_r1 - h_c[h_i1 - 1]) / (h_c[h_i1] - h_c[h_i1 - 1])) AS a1, if(h_n = 0, NULL, h_s / h_n) AS a2 FROM (SELECT g0, sum(h_ds) AS h_s, sum(h_dn) AS h_n, sumMap(h_qk, h_qv, h_qn) AS h_b, h_b.1 AS h_k, arrayCumSum(h_b.2) AS h_c, ? * h_c[-1] AS h_r0, arrayFirstIndex(x -> x >= h_r0, h_c) AS h_i0, ? * h_c[-1] AS h_r1, arrayFirstIndex(x -> x >= h_r1, h_c) AS h_i1 FROM (SELECT attrs[?] AS g0, timestamp, row_number() OVER w = 1 AS h_first, toUnixTimestamp64Nano(start_time) AS h_st, lagInFrame(toUnixTimestamp64Nano(start_time)) OVER w AS h_pst, lagInFrame(`count`) OVER w AS h_pn, lagInFrame(bucket_counts) OVER w AS h_pc, bucket_bounds = lagInFrame(bucket_bounds) OVER w AS h_same, temporality = 'delta' OR (NOT h_first AND ((h_st != 0 AND h_pst != 0 AND h_st != h_pst) OR `count` < h_pn OR (h_same AND arrayExists((x, y) -> x < y, bucket_counts, arrayResize(h_pc, length(bucket_counts)))))) OR (h_first AND h_st != 0 AND start_time >= ?) AS h_whole, multiIf(h_whole, toInt64(`count`), h_first, 0, toInt64(`count`) - toInt64(h_pn)) AS h_dn, multiIf(h_whole, `sum`, h_first, 0, `sum` - lagInFrame(`sum`) OVER w) AS h_ds, multiIf(h_whole, arrayMap(x -> toInt64(x), bucket_counts), h_first OR NOT h_same, emptyArrayInt64(), arrayMap((x, y) -> toInt64(x) - toInt64(y), bucket_counts, arrayResize(h_pc, length(bucket_counts)))) AS h_dc, length(h_dc) > 0 AND length(h_dc) = length(bucket_bounds) + 1 AS h_hasb, if(h_hasb, arrayPushBack(bucket_bounds, inf), []) AS h_qk, if(h_hasb, h_dc, []) AS h_qv, arrayMap(x -> toUInt8(1), h_qk) AS h_qn FROM tidemark.metric_points WHERE timestamp >= ? AND timestamp < ? AND (lower(name) = lower(?)) AND (kind IN ('histogram', 'exp_histogram') OR (kind = 'summary' AND temporality != '')) WINDOW w AS (PARTITION BY stream, series_id ORDER BY timestamp ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)) WHERE timestamp >= ? GROUP BY g0 HAVING count() > 0) WHERE (a0 > ?) ORDER BY a0 DESC, g0 ASC LIMIT ?
