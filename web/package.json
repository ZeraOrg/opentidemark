{
  "name": "tidemark-web",
  "private": true,
  "version": "0.8.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "npm run mock:worker && vite --mode mock",
    "build": "vite build",
    "mock:worker": "msw init mock-public --no-save && node scripts/copy-public.mjs",
    "build:mock": "npm run mock:worker && vite build --mode mock",
    "preview:mock": "vite preview --mode mock --port 4173 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:csp": "node scripts/check-csp.mjs dist",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource/ibm-plex-sans": "5.1.0",
    "@fontsource/jetbrains-mono": "5.1.0",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-query": "5.62.0",
    "@tanstack/react-virtual": "3.10.9",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-layout": "1.5.0",
    "react-router-dom": "6.30.6",
    "style-mod": "4.1.4",
    "uplot": "1.6.31"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.13.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/react-grid-layout": "1.3.5",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "msw": "2.15.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
