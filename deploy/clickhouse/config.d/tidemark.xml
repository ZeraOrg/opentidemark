<!-- OpenTidemark server settings (SPEC §17.2, §17.3): quieter logs, no MySQL/PostgreSQL protocol
     ports, no crash reports sent to the ClickHouse developers, and the 'backups' disk used by
     `tidemark backup` (SPEC §8.5 item 8). The listen address is left at ClickHouse's default
     (loopback on a native install); the Docker Compose stack adds docker-listen.xml. -->
<clickhouse>
  <logger>
    <level>warning</level>
    <console>1</console>
  </logger>
  <mysql_port remove="1"/>
  <postgresql_port remove="1"/>
  <send_crash_reports>
    <enabled>false</enabled>
  </send_crash_reports>
  <storage_configuration>
    <disks>
      <backups>
        <type>local</type>
        <path>/var/lib/clickhouse/backups/</path>
      </backups>
    </disks>
  </storage_configuration>
  <backups>
    <allowed_disk>backups</allowed_disk>
  </backups>
</clickhouse>
