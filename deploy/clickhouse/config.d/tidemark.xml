<!-- Tidemark server settings: quieter logs, no listeners beyond the internal network defaults,
     and the 'backups' disk used by `tidemark backup` (SPEC §8.5 item 8). -->
<clickhouse>
  <logger>
    <level>warning</level>
    <console>1</console>
  </logger>
  <listen_host>0.0.0.0</listen_host>
  <mysql_port remove="1"/>
  <postgresql_port remove="1"/>
  <storage_configuration>
    <disks>
      <backups>
        <type>local</type>
        <path>/var/lib/clickhouse/backups/</path>
      </backups>
    </disks>
  </storage_configuration>
  <backups>
    <allowed_disk>backups</allowed_disk>
  </backups>
</clickhouse>
