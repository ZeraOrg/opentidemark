# SPDX-License-Identifier: Apache-2.0
# Environment of clickhouse-server on node 3, read by ../clickhouse/config.d/*.xml and
# users.d/tidemark.xml (from_env). Load it through a systemd drop-in, e.g.
# /etc/systemd/system/clickhouse-server.service.d/tidemark-ha.conf:
#   [Service]
#   EnvironmentFile=/etc/clickhouse-server/tidemark-ha.env
# File mode 0640 root:clickhouse: it contains the Tidemark user passwords.
CH_REPLICA=node3
CH_KEEPER_ID=3
CH_LISTEN_HOST=0.0.0.0
CH_INTERSERVER_HOST=tm-node3
CH_NODE1_HOST=tm-node1
CH_NODE2_HOST=tm-node2
CH_NODE3_HOST=tm-node3
TIDEMARK_CLICKHOUSE_WRITER_PASSWORD=generate-me
TIDEMARK_CLICKHOUSE_READER_PASSWORD=generate-me
