# SPDX-License-Identifier: Apache-2.0
# OpenTidemark node 1 of the 3-server HA reference topology (SPEC §17.5). Install as
# /etc/tidemark/tidemark.env (root:tidemark, 0640). Only TIDEMARK_NODE_ID and the order of
# TIDEMARK_CLICKHOUSE_ADDR differ between the nodes; every other value must be identical.
TIDEMARK_NODE_ID=tm-node1

# Metadata in an external HA PostgreSQL (the DSN carries a password: prefer the _FILE form).
TIDEMARK_META_DRIVER=postgres
TIDEMARK_META_DSN_FILE=/etc/tidemark/meta-dsn

# ClickHouse: local replica first, then the others (the client fails over in order).
TIDEMARK_CLICKHOUSE_ADDR=tm-node1:9000,tm-node2:9000,tm-node3:9000
TIDEMARK_CLICKHOUSE_CLUSTER=tidemark_cluster
TIDEMARK_CLICKHOUSE_INSERT_QUORUM=auto
TIDEMARK_CLICKHOUSE_WRITER_PASSWORD=generate-me
TIDEMARK_CLICKHOUSE_READER_PASSWORD=generate-me

# Same secret key file content on every node (copy it from the first node, 0600).
TIDEMARK_SECRET_KEY_FILE=/var/lib/tidemark/secret.key

# The load balancer terminates TLS and sets X-Forwarded-For; trust only its address.
TIDEMARK_PUBLIC_URL=https://tidemark.example.internal
TIDEMARK_TRUSTED_PROXIES=10.0.0.10/32

# Node-local durability; give the LB time to take the node out of rotation on shutdown.
TIDEMARK_WAL_DIR=/var/lib/tidemark/wal
TIDEMARK_WAL_MAX_BYTES=10737418240
TIDEMARK_DRAIN_SECONDS=15
