# SPDX-License-Identifier: Apache-2.0
#
# OpenTidemark Docker Compose settings (SPEC §7, §17.2).
# `./install.sh docker` (Linux/macOS) or `.\install.ps1 -Mode Docker` (Windows) copies this file to
# .env and replaces every "generate-me" value with a random secret. Keep .env private (mode 0600).
# Every TIDEMARK_* variable below is passed to the tidemark container; uncomment to change a default.

# --- Compose only (not read by tidemark) ---------------------------------------------------------
# Image of the tidemark service. In a source checkout the default is tidemark:local, built from
# ../Dockerfile; the Docker release bundle defaults to ghcr.io/zeraorg/tidemark:<its version>.
#TM_IMAGE=ghcr.io/zeraorg/tidemark:<version>
# Version stamped into a locally built image (source checkout only).
#TM_VERSION=dev
# Host address the published ports bind to (127.0.0.1 behind a reverse proxy on the same host).
#TM_BIND_ADDR=0.0.0.0
# Connection key the optional OTel Collector (profile "collector") sends with; defaults to
# TIDEMARK_BOOTSTRAP_INGEST_KEY. Any key allowing the "otlp" protocol works.
#COLLECTOR_INGEST_KEY=

# --- ClickHouse users (required; also given to the clickhouse container) -------------------------
TIDEMARK_CLICKHOUSE_WRITER_PASSWORD=generate-me
TIDEMARK_CLICKHOUSE_READER_PASSWORD=generate-me
#TIDEMARK_CLICKHOUSE_DATABASE=tidemark
#TIDEMARK_CLICKHOUSE_WRITER_USER=tidemark_writer
#TIDEMARK_CLICKHOUSE_READER_USER=tidemark_reader
#TIDEMARK_CLICKHOUSE_TLS=false
# Fixed by docker-compose.yml: TIDEMARK_CLICKHOUSE_ADDR=clickhouse:9000, TIDEMARK_DATA_DIR=/data.
#TIDEMARK_CLICKHOUSE_ADDR=clickhouse:9000
#TIDEMARK_DATA_DIR=/data

# --- First start ---------------------------------------------------------------------------------
# Without TIDEMARK_ADMIN_PASSWORD the first start seeds admin/admin, which must be changed (§15.2).
#TIDEMARK_ADMIN_USERNAME=admin
#TIDEMARK_ADMIN_PASSWORD=
# Creates the connection "bootstrap" (all protocols) with this key on first start;
# install.sh generates one; never set a short or guessable key here.
#TIDEMARK_BOOTSTRAP_INGEST_KEY=

# --- Listeners and TLS ---------------------------------------------------------------------------
#TIDEMARK_HTTP_ADDR=:8080
#TIDEMARK_SEQ_ADDR=:5341
#TIDEMARK_ES_ADDR=:9200
#TIDEMARK_OTLP_HTTP_ADDR=:4318
#TIDEMARK_OTLP_GRPC_ADDR=:4317
# Paths inside the container (mount the files read-only); both set => TLS on every listener.
#TIDEMARK_TLS_CERT_FILE=
#TIDEMARK_TLS_KEY_FILE=
#TIDEMARK_PUBLIC_URL=http://localhost:8080
# CIDRs whose X-Forwarded-For is trusted (reverse proxies).
#TIDEMARK_TRUSTED_PROXIES=

# --- Ingestion and queries -----------------------------------------------------------------------
#TIDEMARK_BATCH_MAX_ROWS=10000
#TIDEMARK_BATCH_MAX_WAIT=1s
#TIDEMARK_QUEUE_MAX_ROWS=200000
#TIDEMARK_DEADLETTER_MAX_BYTES=1073741824
#TIDEMARK_MAX_BODY_BYTES=10485760
#TIDEMARK_MAX_DECOMPRESSED_BYTES=104857600
#TIDEMARK_QUERY_TIMEOUT=30s
#TIDEMARK_QUERY_MAX_ROWS=10000
#TIDEMARK_MAX_STREAMS=200

# --- Sessions and security -----------------------------------------------------------------------
#TIDEMARK_SESSION_IDLE_TIMEOUT=12h
#TIDEMARK_SESSION_ABSOLUTE_TIMEOUT=168h
#TIDEMARK_ALLOW_PRIVATE_WEBHOOKS=false
#TIDEMARK_SECRET_KEY_FILE=/data/secret.key

# --- Email notifications -------------------------------------------------------------------------
#TIDEMARK_SMTP_HOST=
#TIDEMARK_SMTP_PORT=587
#TIDEMARK_SMTP_USERNAME=
#TIDEMARK_SMTP_PASSWORD=
#TIDEMARK_SMTP_FROM=
#TIDEMARK_SMTP_STARTTLS=true

# --- Durability (SPEC §8.5, §9.8) -----------------------------------------------------------------
#TIDEMARK_WAL_ENABLED=true
#TIDEMARK_WAL_DIR=/data/wal
#TIDEMARK_WAL_MAX_BYTES=10737418240
#TIDEMARK_WAL_SYNC=batch
#TIDEMARK_WAL_EXIT_ON_FAILURE=true
#TIDEMARK_WAL_MIN_FREE_BYTES=1073741824
#TIDEMARK_BACKUP_DIR=/data/backups

# --- High availability (SPEC §17.5; see deploy/ha/) ------------------------------------------------
#TIDEMARK_NODE_ID=
#TIDEMARK_META_DRIVER=sqlite
#TIDEMARK_META_DSN=
#TIDEMARK_CLICKHOUSE_CLUSTER=
#TIDEMARK_CLICKHOUSE_INSERT_QUORUM=auto
#TIDEMARK_DRAIN_SECONDS=10

# --- Operations ----------------------------------------------------------------------------------
#TIDEMARK_LOG_LEVEL=info
#TIDEMARK_METRICS_ENABLED=false
#TIDEMARK_METRICS_TOKEN=
# Read inside the container; .env itself is not mounted.
#TIDEMARK_ENV_FILE=/data/tidemark.env

# --- Update check (SPEC §17.7) ---------------------------------------------------------------------
# Daily check of the latest release on api.github.com (no installation data is sent); false = no update traffic.
#TIDEMARK_UPDATE_CHECK=true
# Explicit http(s) proxy for the check, e.g. http://user:password@proxy:3128 (HTTPS_PROXY is ignored).
#TIDEMARK_UPDATE_PROXY=
