# SPDX-License-Identifier: Apache-2.0
# systemd unit for a native Linux install (SPEC §15.9, §17.3); installed by deploy/install.sh.
[Unit]
Description=OpenTidemark observability platform
Documentation=https://github.com/ZeraOrg/opentidemark
After=network-online.target clickhouse-server.service
Wants=network-online.target

[Service]
Type=simple
User=tidemark
Group=tidemark
Environment=TIDEMARK_DATA_DIR=/var/lib/tidemark
Environment=TIDEMARK_ENV_FILE=/etc/tidemark/tidemark.env
ExecStart=/usr/local/bin/tidemark serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
LimitNOFILE=65536
UMask=0027

# Hardening. MemoryDenyWriteExecute is deliberately not set: the SQLite driver runs WebAssembly
# through wazero's compiler, which needs executable memory it writes itself.
ReadWritePaths=/var/lib/tidemark
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
